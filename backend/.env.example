# ---------- Servidor ----------
NODE_ENV=development
PORT=3000
# Ruta del archivo SQLite (se crea solo).
DATABASE_PATH=./data/chochopagos.db
# Carpeta donde se guardan las fotos de recibos y evidencias
MEDIA_DIR=./data/media
# Carga datos de demostración (Rosa y Jairo con PIN 1234, saldos iniciales) si la base está vacía
SEED_DEMO=true
LOG_LEVEL=info

# ---------- Sesiones y personal ----------
# Secreto para firmar sesiones (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si lo dejas vacío en desarrollo, se genera uno al azar y las sesiones se cierran al reiniciar.
AUTH_SECRET=
# Acceso del domiciliario y del Centro (pantallas "Inicia tu turno" y "Acceso del punto")
OPERATOR_ID=OP-01
OPERATOR_PIN=1234
OPERATOR_NAME=Carlos
CENTER_ID=CC-01
CENTER_PIN=1234

# ---------- Bot de Telegram ----------
# Token que te da @BotFather al crear el bot (123456789:AA...).
# Si está vacío, los mensajes del bot se imprimen en consola;
# la app web y POST /dev/simulate siguen funcionando.
# Funciona en local sin túnel: el servidor le pregunta a Telegram por mensajes nuevos.
TELEGRAM_BOT_TOKEN=

# ---------- Voz (modelos locales) ----------
# Notas de voz de Telegram → texto con faster-whisper (carpeta ../whisper).
# Deja WHISPER_PYTHON vacío para desactivarlo. Las rutas relativas son desde backend/.
WHISPER_PYTHON=../whisper/.venv/bin/python
WHISPER_MODEL_DIR=../whisper/modelos/faster-whisper-large-v3-turbo
# Núcleos de CPU para Whisper (0 = todos)
WHISPER_THREADS=0
# Respuestas con voz (Kokoro) a quien habla por Telegram. Vacío = desactivado.
KOKORO_PYTHON=~/kokoro-local/.venv/bin/python
# ef_dora (femenina) o em_alex (masculina)
KOKORO_VOICE=ef_dora
KOKORO_SPEED=1.0
# ffmpeg convierte la voz al formato de notas de voz de Telegram (OGG/Opus)
FFMPEG_PATH=ffmpeg

# ---------- Lectura de recibos ----------
# true = OCR con tesseract.js en el servidor (descarga el idioma español la primera vez)
OCR_ENABLED=true

# ---------- Negocio ----------
DELIVERY_FEE=3000
SECTORS=Alto del Chocho,Vereda vecina
PAPER_SHEETS=120
# Minutos de inactividad tras los cuales el asistente olvida una conversación a medias
SESSION_TTL_MINUTES=30
